# Copiați acest fișier ca transfer.env (în același folder) și completați-l.
# transfer.env NU se pune în git (e în .gitignore): poate conține token-uri.

# --- GitHub ---
SRC_REPO=bogdanpaulmurar-hash/Medical   # de unde pleacă repo-ul
DST_OWNER=                              # organizația GitHub a medicului (recomandat) sau contul lui personal
REPO_NAME=Medical                       # numele repo-ului după transfer (poate fi altul, ex. vademecum-mfr)

# --- Supabase ---
SUPABASE_REF=yuqggvokpnqrpgizmgnw       # proiectul „MedSlot Prod” (eu-west-1)
DST_SUPABASE_ORG_SLUG=                  # slug-ul organizației Supabase a medicului (din adresa dashboard/org/<slug>)
SUPABASE_ACCESS_TOKEN=                  # token personal: supabase.com/dashboard/account/tokens (ștergeți-l după transfer)
# Opțional, pentru copia de siguranță a bazei (01-snapshot.sh) și verificările SQL din 06-smoke-test.sh.
# Din dashboard: Connect → Session pooler. Conține parola bazei: nu-l lipiți nicăieri altundeva.
SUPABASE_DB_URL=

# --- Unde se salvează instantaneele și copiile de siguranță (în afara repo-ului) ---
SNAPSHOT_ROOT=$HOME/vademecum-transfer
